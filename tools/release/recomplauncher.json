{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "DKB Recomp",
  "repo": "Lucas-blip-png/dkb-pc-recomp",
  "inputs": [
    {
      "id": "game",
      "label": "Your own dump of Donkey Kong Bananza: the .nup file (1.0.0, or with the 3.2.0 update inside), or a folder with its exefs and romfs.",
      "formats": [{ "type": "file", "extensions": ["nup"] }, { "type": "folder" }]
    }
  ],
  "prepare": {
    "program": ["setup.sh", "setup.command"],
    "args": ["--prepare", "--source", "{input:game}", "--dest", "{install}/game"],
    "label": "Building the game from your copy (it compiles everything on this computer and takes a while)",
    "done": ["{install}/game/dkb"]
  },
  "start": {
    "program": ["play.sh"]
  },
  "saves": ["{install}/game/profile"],
  "config": [
    { "id": "main", "format": "ini", "file": [{ "path": "{install}/game/dkb.ini" }] }
  ],
  "settings": [
    {
      "id": "perf_overlay",
      "label": "Performance overlay",
      "choices": [
        { "label": "Off", "set": { "perf_overlay": "off" } },
        { "label": "FPS", "set": { "perf_overlay": "fps" } },
        { "label": "Large FPS counter", "set": { "perf_overlay": "counter" } },
        { "label": "Full", "set": { "perf_overlay": "full" } },
        { "label": "Breakdown", "set": { "perf_overlay": "breakdown" } }
      ],
      "defaults": { "perf_overlay": "off" }
    },
    {
      "id": "hdr",
      "label": "HDR output",
      "choices": [
        { "label": "Off", "set": { "hdr": "0" } },
        { "label": "On", "set": { "hdr": "1" } }
      ],
      "defaults": { "hdr": "0" }
    },
    {
      "id": "mouse_camera",
      "label": "Direct mouse camera",
      "choices": [
        { "label": "Off", "set": { "mouse_camera": "0" } },
        { "label": "On", "set": { "mouse_camera": "1" } }
      ],
      "defaults": { "mouse_camera": "0" }
    }
  ]
}
