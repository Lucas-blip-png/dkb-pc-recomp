#version 450

// Conditional staged-upload merge: one workgroup per disjoint word-aligned chunk (up to 64 KiB).
// Copies staged CPU words into the VRAM mirror only where an earlier in-flight submission left its
// pre-pass snapshot unchanged, preserving words that the earlier submission wrote on the GPU.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly restrict buffer Staging { uint src[]; };
layout(std430, binding = 1) restrict buffer Mirror { uint mbuf[]; };
layout(std430, binding = 2) readonly restrict buffer Before { uint pre[]; };
layout(std430, binding = 3) readonly restrict buffer Ranges { uvec4 ranges[]; };
layout(push_constant) uniform Params { uint first_range; };

void main() {
    uvec4 r = ranges[first_range + gl_WorkGroupID.x];
    for (uint i = gl_LocalInvocationID.x; i < r.w; i += gl_WorkGroupSize.x) {
        uint m = r.y + i;
        if (mbuf[m] == pre[r.z + i]) {
            mbuf[m] = src[r.x + i];
        }
    }
}
