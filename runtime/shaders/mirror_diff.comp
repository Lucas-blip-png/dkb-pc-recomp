#version 450

// Differential mirror write-back: one workgroup per disjoint word-aligned chunk (up to 64 KiB).
// Stores mirror words into guest memory only where the GPU changed them since the pre-pass snapshot,
// leaving untouched words in guest memory intact when the CPU writes other slots on the same page.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly restrict buffer Mirror { uint mbuf[]; };
layout(std430, binding = 1) writeonly restrict buffer Guest { uint dst[]; };
layout(std430, binding = 2) readonly restrict buffer Before { uint pre[]; };
layout(std430, binding = 3) readonly restrict buffer Ranges { uvec4 ranges[]; };
layout(push_constant) uniform Params { uint first_range; };

void main() {
    uvec4 r = ranges[first_range + gl_WorkGroupID.x];
    for (uint i = gl_LocalInvocationID.x; i < r.z; i += gl_WorkGroupSize.x) {
        uint v = mbuf[r.x + i];
        if (v != pre[r.y + i]) {
            dst[r.x + i] = v;
        }
    }
}
