#version 450

// Pre-write mirror snapshot copy: one workgroup per disjoint word-aligned chunk (up to 64 KiB).
// Copies mirror words into a pre-write snapshot buffer in one compute dispatch per (pool, snapshot buffer)
// group instead of issuing thousands of small vkCmdCopyBuffer regions.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly restrict buffer Mirror { uint mbuf[]; };
layout(std430, binding = 1) writeonly restrict buffer Before { uint pre[]; };
layout(std430, binding = 2) readonly restrict buffer Unused { uint unused_[]; };
layout(std430, binding = 3) readonly restrict buffer Ranges { uvec4 ranges[]; };
layout(push_constant) uniform Params { uint first_range; };

void main() {
    uvec4 r = ranges[first_range + gl_WorkGroupID.x];
    for (uint i = gl_LocalInvocationID.x; i < r.z; i += gl_WorkGroupSize.x) {
        pre[r.y + i] = mbuf[r.x + i];
    }
}
